{
  "name": "lhp-operating-point",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "description": "Interactive loop heat pipe study model — how the compensation chamber sets the loop operating point",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
